import /vendor/etc/init/hw/init.huidu.display.rc

on early-init
    load_persist_props
    write /sys/devices/system/cpu/cpufreq/policy0/scaling_governor performance
    write /sys/class/devfreq/dmc/governor performance
    write /sys/devices/platform/fde60000.gpu/devfreq/fde60000.gpu/governor performance

on property:vendor.boot_completed=1
    start huidu_init
    start boot_counter
    stop huidu_recovery

service huidu_init /system/bin/sh /system/bin/huidu_init.sh
    class main
    user root
    group root
    seclabel u:r:shell:s0
    oneshot

service boot_counter /system/bin/sh /system/bin/boot_counter.sh
    class main
    user root
    group root
    disabled
    seclabel u:r:shell:s0
    oneshot

service huidu_recovery /system/bin/sh /system/bin/huidu_recovery.sh
    class core
    seclabel u:r:system_app:s0

service sshd /system/bin/start-ssh
    class core
    seclabel u:r:system_app:s0

